---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from 'emdash'
import BaseLayout from '@layouts/Base.astro'
import PageBlocks from '@components/PageBlocks.astro'

// The home page is the "home" entry of Admin → Páginas.
const { entry: page, cacheHint } = await getEmDashEntry('pages', 'home')

if (!page) {
  return Astro.redirect('/404')
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint)

const settings = await getSiteSettings()
const separator = settings.seo?.titleSeparator ?? ' - '
const seo = getSeoMeta(page, {
  defaultTitle: settings.tagline,
  defaultDescription: page.data.description
})
---

<BaseLayout
  title={`${settings.title}${separator}${seo.title}`}
  pageTitle={settings.title}
  description={seo.description}
  content={{ collection: 'pages', id: page.data.id, slug: page.id }}
>
  <PageBlocks value={page.data.layout} />
</BaseLayout>
