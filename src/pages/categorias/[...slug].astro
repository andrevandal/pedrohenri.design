---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from 'emdash'

import TheHomeCategoryListing from '@components/TheHomeCategoryListing.astro'
import BaseLayout from '@layouts/Base.astro'
import { sortPostsByDate, toCategoryListing } from '@utils/cms'
import { socialImageUrl } from '@utils/media'

const { slug } = Astro.params

if (!slug) {
  return Astro.redirect('/404')
}

const { entry: rawCategory, cacheHint } = await getEmDashEntry(
  'categories',
  slug,
  { references: { posts: { limit: 100 } } }
)

if (!rawCategory) {
  return Astro.redirect('/404')
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint)

const category = toCategoryListing(
  rawCategory,
  sortPostsByDate(rawCategory.references?.posts.entries ?? [])
)
const settings = await getSiteSettings()

// SEO panel values win; the category's description and social image are the
// fallbacks.
const seo = getSeoMeta(rawCategory, {
  siteTitle: settings.title,
  titleSeparator: settings.seo?.titleSeparator,
  defaultTitle: category.name,
  defaultDescription: category.description
})
---

<BaseLayout
  title={seo.title}
  pageTitle={seo.ogTitle}
  description={seo.description}
  image={socialImageUrl(
    rawCategory.data.social_image,
    Astro.url,
    Astro.locals.emdash?.getPublicMediaUrl
  )}
  content={{
    collection: 'categories',
    id: rawCategory.data.id,
    slug: rawCategory.id
  }}
>
  <div class='container mx-auto flex flex-col pt-6 pb-8 lg:pt-10 lg:pb-12'>
    <TheHomeCategoryListing {...category} />
  </div>
</BaseLayout>
