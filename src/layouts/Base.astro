---
import '../styles/base.css'

import { getSiteSettings } from 'emdash'
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from 'emdash/ui'
import { createPublicPageContext } from 'emdash/page'

import TheFooter from '@components/TheFooter.astro'
import TheFooterCta from '@components/TheFooterCta.astro'
import TheHeader from '@components/TheHeader.astro'
import { getImageUrl } from '@utils'

type Props = {
  /** Full document title */
  title: string
  /** Page-only title for Open Graph / Twitter / JSON-LD */
  pageTitle?: string
  /** Fallback description; the entry's SEO panel wins when set */
  description?: string | null
  /** Fallback share image (absolute URL); the SEO panel wins when set */
  image?: string | null
  pageType?: string
  /** The rendered EmDash entry, so its SEO panel applies */
  content?: { collection: string; id: string; slug?: string | null }
}

const { PUBLIC_GOOGLE_ANALYTICS_ID: googleAnalyticsId } = import.meta.env
const {
  title,
  pageTitle,
  description,
  image,
  pageType = 'website',
  content
} = Astro.props

const settings = await getSiteSettings()

const page = createPublicPageContext({
  Astro,
  kind: content ? 'content' : 'custom',
  pageType,
  title,
  pageTitle,
  description,
  image:
    image ||
    getImageUrl('images/imagem-social.png', 'f_auto,q_90,w_1200,h_630'),
  canonical: Astro.url.href,
  content,
  siteName: settings.title
})
---

<html class='font-stara h-full scroll-p-20.5 scroll-smooth' lang='pt-br'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width' />
    <title>{title}</title>
    {!settings.favicon && (
      <>
        <link
          rel='icon'
          type='image/png'
          href={getImageUrl('images/favicon.png')}
        />
        <link rel='apple-touch-icon' href={getImageUrl('images/icon.png')} />
      </>
    )}
    <link rel='sitemap' href='/sitemap.xml' />
    <EmDashHead page={page} />
    <link
      href='/css/fonts.css'
      rel='preload'
      as='style'
      onload=`this.rel="stylesheet"`
    />
    {googleAnalyticsId && (
      <>
        <link
          href={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
          rel='preload'
          as='script'
        />
        <script
          is:inline
          set:html={`
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () {
                dataLayer.push(arguments);
              };
              window.gtag('js', new Date());
              window.gtag('config', '${googleAnalyticsId}');`}
        />
      </>
    )}
  </head>
  <body class='h-full'>
    <EmDashBodyStart page={page} />
    <TheHeader />
    <slot />
    <TheFooter>
      <TheFooterCta />
    </TheFooter>
    {googleAnalyticsId && (
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
        type='text/partytown'
        is:inline
      />
    )}
    <EmDashBodyEnd page={page} />
  </body>
</html>
