---
import type { BlockComponentProps } from 'emdash/ui'
import { Image } from 'emdash/ui'
import type { PageLayoutHeroBlock } from '../../../emdash-env'
import BaseButton from '@components/BaseButton.astro'

type Props = BlockComponentProps<PageLayoutHeroBlock>

const { value } = Astro.props
const headingLines = value.heading.split('\n')
---

<section class='flex flex-col rounded-lg bg-gray-50 py-4 sm:pb-6 lg:grid lg:grid-cols-12 lg:items-center lg:justify-between lg:gap-x-6 lg:px-8 lg:py-8'>
  <div class='order-2 flex flex-1 flex-col gap-2 px-4 sm:px-6 lg:order-1 lg:col-span-7 lg:col-start-1 lg:px-0'>
    <h1 class='typography-title max-w-[38ch] font-extrabold text-gray-900'>
      {headingLines.map((line, index) => (
        <>
          {index > 0 && <br />}
          {line}
        </>
      ))}
    </h1>
    {value.text && (
      <p class='mb-4 max-w-[38ch] text-xl text-gray-900 lg:text-2xl'>
        {value.text}
      </p>
    )}
    {value.button_label && value.button_link && (
      <BaseButton
        icon='heroicons:arrow-down'
        href={value.button_link}
        variant='primary'
        size='medium'
        className='w-full! sm:w-fit!'
        increaseSize
      >
        {value.button_label}
      </BaseButton>
    )}
  </div>
  {value.image && (
    <div class='order-1 flex h-auto w-full flex-1 px-4 lg:order-2 lg:col-span-5 lg:col-start-8 lg:px-0'>
      <Image
        image={value.image}
        sizes='(min-width: 1280px) 423px, (min-width: 1024px) 352px, (min-width: 640px) 475px, 311px'
        class='aspect-9/10 h-auto w-full object-cover'
        priority
      />
    </div>
  )}
</section>
