---
/**
 * Dark call-to-action card above the footer, edited in Admin → Widgets →
 * "footer_cta". The first content widget supplies the heading (widget title),
 * text, button(s) and image (its Portable Text content).
 */
import type { PortableTextBlock } from 'emdash'
import { getWidgetArea } from 'emdash'
import { Image, PortableText } from 'emdash/ui'
import BaseButton from '@components/BaseButton.astro'

type ImageBlock = PortableTextBlock & {
  asset?: { _ref: string; url?: string; provider?: string }
  alt?: string
  width?: number
  height?: number
}
type ButtonBlock = { _key: string; text: string; url?: string }

const area = await getWidgetArea('footer_cta')
const widget = area?.widgets.find((item) => item.type === 'content')
const blocks = (widget?.content ?? []) as PortableTextBlock[]

const image = blocks.find(
  (block): block is ImageBlock => block._type === 'image'
)
const buttons = blocks.flatMap((block) => {
  if (block._type === 'button') return [block as unknown as ButtonBlock]
  if (block._type === 'buttons') return block.buttons as ButtonBlock[]
  return []
})
const text = blocks.filter(
  (block) => !['image', 'button', 'buttons'].includes(block._type)
)
---

{widget && (
  <div class='container'>
    <div class='flex flex-col gap-6 rounded-lg bg-gray-900 p-4 sm:p-6 lg:grid lg:grid-cols-12 lg:items-center lg:justify-between lg:gap-x-6 lg:px-8 lg:py-8'>
      {image?.asset && (
        <div class='lg:order-2 lg:col-span-5 lg:col-start-8 lg:flex-1'>
          <Image
            image={{
              id: image.asset._ref,
              provider: image.asset.provider,
              src: image.asset.url,
              width: image.width,
              height: image.height,
              alt: image.alt
            }}
            sizes='(min-width: 1280px) 469px, (min-width: 1024px) 362px, (min-width: 640px) 448px, 311px'
            class='aspect-square h-auto w-full rounded-lg object-cover'
          />
        </div>
      )}
      <div class='flex flex-col items-center gap-y-4 text-center lg:order-1 lg:col-span-7 lg:col-start-1 lg:flex-1 lg:items-start lg:justify-center lg:text-left'>
        {widget.title && (
          <h2 class='max-w-[38ch] text-[2rem] leading-9 font-bold tracking-[-0.1rem] text-gray-50 lg:text-[3rem] lg:leading-13.5 lg:tracking-[-0.15rem]'>
            {widget.title}
          </h2>
        )}
        <div class='max-w-[38ch] text-xl text-gray-50 lg:text-2xl'>
          <PortableText value={text} />
        </div>
        {buttons.map((button) => (
          <BaseButton
            href={button.url}
            variant='secondary'
            className='mt-2'
            icon='heroicons-outline:chat-alt-2'
          >
            {button.text}
          </BaseButton>
        ))}
      </div>
    </div>
  </div>
)}
