{
  "name": "@andrevandal/pedrohenri.design",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write ",
    "astro": "astro",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:cloudflare": "astro check && DEPLOY_TARGET=cloudflare astro build",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy",
    "preview:wrangler": "pnpm build:cloudflare && wrangler dev",
    "check": "astro check",
    "generate": "astro build",
    "preview": "astro preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "deps:check": "pnpx npm-check-updates",
    "deps:check:semver": "pnpx npm-check-updates -t semver"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@emdash-cms/cloudflare": "^1.0.1",
    "@libsql/kysely-libsql": "^0.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-iconset": "^0.0.6",
    "emdash": "^1.0.1",
    "nodemailer": "^10.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "worker-mailer": "^1.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrevandal/pedrohenri.design.git"
