  "devDependencies": {
    "@astrojs/partytown": "^2.1.8",
    "@eslint/js": "^10.0.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/heroicons-outline": "^1.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "@svgr/plugin-prettier": "^8.1.0",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "clsx": "^2.1.1",
